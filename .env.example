# ─────────────────────────────────────────────────────────────────────────────
# CSC Reel Generator: environment template
# Copy to .env and fill in your own keys. NEVER commit .env (gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ─── LLM routing (Claude Sonnet for Plan, Claude Haiku for Extract) ───
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# ─── Langfuse Cloud (free tier: tracing + cost capture) ───
# Sign up free at https://cloud.langfuse.com (50k observations/month)
LANGFUSE_PUBLIC_KEY=pk-lf-your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Replicate (Flux Schnell image generation, 9:16) ───
# Get from https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_replicate_token_here

# ─── ElevenLabs (voice clone TTS + optional Music) ───
# Get from https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Voice ID after creating Instant Voice Clone of your own voice (or any voice)
# https://elevenlabs.io/app/voice-lab → Add Voice → Instant Voice Clone
# Tip: this app ships with the candidate's cloned voice by default; replace with
# your own ID to hear reels in your voice.
ELEVENLABS_VOICE_ID=your_voice_id_here

# ─── Models (defaults; override only if you want to swap) ───
PLAN_MODEL=anthropic/claude-sonnet-4-6
EXTRACT_MODEL=anthropic/claude-haiku-4-5
IMAGE_MODEL=black-forest-labs/flux-schnell

# ─── Pipeline defaults ───
DEFAULT_DURATION_S=5
DEFAULT_WITH_MUSIC=false
RUNS_DIR=./runs
DEV_CACHE_DIR=./experiments/cache

# ─── Production cost cap (studio.sshub.dev) ───
# Aborts new runs when the day's cumulative cost exceeds this USD value.
# Counted per UTC day. Independent of which auth user triggered the run.
DAILY_COST_CAP_USD=5.00

# ─── ElevenLabs monthly character quota tracker ───
# Starter plan: 30,000 chars/month (~30 min audio). Set to 100000 for Creator.
ELEVENLABS_MONTHLY_CHAR_LIMIT=30000
# Block new TTS calls once usage exceeds this percent of the limit.
ELEVENLABS_QUOTA_BLOCK_AT_PCT=90

# ─── App version (bump before each deploy per SKILL.md Phase 9) ───
APP_VERSION=0.1.0
